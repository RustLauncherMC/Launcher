{
  "name": "RustLauncherMC",
  "short_name": "RustLauncherMC",
  "description": "Free, fan-made Minecraft launcher for Windows and Linux, for Horizon (Java) and Cinnabar (Bedrock), the Rust editions.",
  "start_url": "./",
  "scope": "./",
  "display": "browser",
  "background_color": "#131416",
  "theme_color": "#131416",
  "icons": [
    { "src": "img/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "img/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "img/logo.svg", "sizes": "any", "type": "image/svg+xml" }
  ]
}
